# Copiar a .env en el servidor y rellenar. El .env NUNCA se sube al repositorio.

# Universo de los escaneos programados: nasdaq100 | nasdaq | sp500 | favorites
SCHEDULED_UNIVERSE=nasdaq100
# Condiciones mínimas para enviar notificación (de 5)
ALERT_MIN_COND=5
SCHEDULER_ENABLED=1
# eToro: claves de la cuenta real (api-portal.etoro.com -> Settings -> Trading -> API Key Management).
# Permiten operar en la cuenta: solo aquí, nunca en el repositorio ni en la app. SyncTrade solo las usa para leer.
ETORO_API_KEY=
ETORO_USER_KEY=
